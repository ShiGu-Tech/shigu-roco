  "source": "官方图卡「先搞懂：种族值&个体值」「①真实数值怎么算」(roco pet – RocoDiviner) + 实测校准（音速犬 / 银月狼王 / 冰钻布鲁斯 5★ L60、小星光 0★ L45 逐格对拍）",
  "level": {
    "default": 60,
    "note": "等级 L 参与面板换算；缺省 60（PVP 基准）。公式见 panels。"
  },
  "panels": {
    "hp": {
      "base": 10,
      "raceBase": 0.5,
      "ivBase": 0.25,
      "levelBase": 1,
      "raceSlope": 0.02,
      "ivSlope": 0.01,
      "note": "生命(L) = round( 性格 × round( 10 + 0.5·种族 + 0.25·个体 + (1 + 0.02·种族 + 0.01·个体)·L ) )；L60 = 种族×1.7 + 个体×0.85 + 70（与官方图卡一致）；每级提升（不含性格）= 1 + (2·种族 + 个体)/100。"
    },
    "default": {
      "base": 10,
      "raceBase": 0.5,
      "ivBase": 0.25,
      "levelBase": 0,
      "raceSlope": 0.01,
      "ivSlope": 0.005,
      "note": "攻/防/速(L) = round( 性格 × round( 10 + (种族 + 个体×0.5)·(L+50)/100 ) ) —— 即 6 系数展开，base=10、raceBase=0.5、ivBase=0.25、levelBase=0、raceSlope=0.01、ivSlope=0.005；每级提升（不含性格）= (种族 + 个体×0.5)/100；(L+50)/100 在 L60 = 1.1，与图卡一致。"
    }
  },
  "natureScaling": {
    "upBase": 1.1,
    "upPerStar": 0.02,
    "downFactor": 0.9,
    "starMax": 5,
    "note": "性格正向系数 = upBase + upPerStar×星级（0★=1.10、1★=1.12 … 5★=1.20；官方卡只标满星 +20%）；负向固定 downFactor=0.90（各星一致）；中性 1.0。乘在括号上、先取整括号再乘。"
  },
  "starBonus": {
    "hp": 20,
    "default": 10,
    "starMax": 5,
    "note": "每星：生命 +20、其他五项 +10（0★=0 … 5★=+100/+50，线性、5★封顶，加在性格之后）。已由 5★ 样本确认（音速犬 / 银月狼王 / 冰钻布鲁斯）。【待校准】是否随等级缩放（现有样本均 L60）。"
  },
  "individual": {
    "starMultiplier": 6,
    "maxPerStat": 60,
    "starMax": 5,
    "investCount": 3,
    "note": "天分 1~10；每升一星加一倍，满星 5★ = ×6 → 个体值 0~60；只能加在 3 项上，每项 ≤ +60。"
  },
  "talentRecommend": {
    "speedThreshold": 115,
    "hpThreshold": 100,
    "attackThreshold": 105,
    "note": "机械推荐加点（v1，先用参数固定，后续由 AI 结合精灵技能池替代）：速度种族 ≥speedThreshold 加速度；生命种族 ≥hpThreshold 加生命；物攻/魔攻较高者 ≥attackThreshold 加该攻击项；性格削弱项一律排除；其余按性格导向的角色模板与种族值记分取前 investCount 项、每项拉满。实现见 modules/pets/recommend.ts，设计见《精灵实例与仓库-设计-v0.1》。"
  },
